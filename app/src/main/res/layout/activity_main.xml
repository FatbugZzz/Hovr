<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A1612"
    android:fitsSystemWindows="true">

    <!-- ── HEADER ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#242018"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <!-- Top row: logo + actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <!-- Logo -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HOVR"
                    android:textColor="#F0A050"
                    android:fontFamily="monospace"
                    android:textSize="16sp"
                    android:letterSpacing="0.25"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="14dp"
                    android:background="#3A3228"
                    android:layout_marginHorizontal="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_overlay_viewer"
                    android:textColor="#3A3228"
                    android:fontFamily="monospace"
                    android:textSize="10sp"
                    android:letterSpacing="0.1" />
            </LinearLayout>

            <!-- Language toggle -->
            <TextView
                android:id="@+id/btnLanguage"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="@string/btn_language"
                android:textColor="#4A3A2A"
                android:fontFamily="monospace"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:gravity="center"
                android:background="@drawable/card_bg"
                android:paddingHorizontal="10dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Stop pill -->
            <LinearLayout
                android:id="@+id/btnStopOverlay"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/btn_pill_danger"
                android:paddingHorizontal="13dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_close"
                    android:layout_marginEnd="5dp" />
                <TextView
                    android:id="@+id/tvBtnClose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_close"
                    android:textColor="#E05C5C"
                    android:fontFamily="monospace"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Gallery pill -->
            <LinearLayout
                android:id="@+id/btnOpenGallery"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/btn_pill_amber"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_gallery"
                    android:layout_marginEnd="6dp" />
                <TextView
                    android:id="@+id/tvBtnGallery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_gallery"
                    android:textColor="#1A1612"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- URL pill -->
            <LinearLayout
                android:id="@+id/btnOpenUrl"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/btn_pill_terra"
                android:paddingHorizontal="14dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_link"
                    android:layout_marginEnd="6dp" />
                <TextView
                    android:id="@+id/tvBtnUrl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_url"
                    android:textColor="#C8855A"
                    android:fontFamily="monospace"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Night mode status bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1C1812"
            android:paddingHorizontal="10dp">

            <TextView
                android:id="@+id/tvNightStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/night_off"
                android:textColor="#3A3228"
                android:fontFamily="monospace"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/btnNightSettings"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:text="⚙"
                android:textColor="#4A3A2A"
                android:textSize="13sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

    </LinearLayout>

    <!-- ── TABS ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E1A14">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/btnTabFavorites"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tab_favorites"
                    android:textColor="#F0A050"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:paddingBottom="6dp"
                    android:clickable="true"
                    android:focusable="true" />

                <View
                    android:id="@+id/tabIndicatorFav"
                    android:layout_width="40dp"
                    android:layout_height="2dp"
                    android:background="@drawable/tab_indicator" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/btnTabHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tab_history"
                    android:textColor="#3A3228"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:paddingBottom="6dp"
                    android:clickable="true"
                    android:focusable="true" />

                <View
                    android:id="@+id/tabIndicatorHist"
                    android:layout_width="40dp"
                    android:layout_height="2dp"
                    android:background="@drawable/tab_indicator"
                    android:visibility="invisible" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnClearHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="🗑"
                android:textColor="#5A3030"
                android:textSize="15sp"
                android:paddingHorizontal="14dp"
                android:gravity="center"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#28302820" />
    </LinearLayout>

    <!-- ── EMPTY STATE ── -->
    <LinearLayout
        android:id="@+id/tvEmptyLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="48dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✦"
            android:textColor="#2E2820"
            android:textSize="32sp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvEmptyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_favorites"
            android:textColor="#3A3228"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:gravity="center" />

    </LinearLayout>

    <!-- ── LIST ── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp"
        android:clipToPadding="false" />

</LinearLayout>
