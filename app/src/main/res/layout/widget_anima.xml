<?xml version="1.0" encoding="utf-8"?>
<!-- Root must be a RemoteViews-compatible layout -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <!-- Thumbnail of last favorite -->
    <ImageView
        android:id="@+id/widgetImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Último favorito" />

    <!-- Dark gradient overlay at bottom -->
    <View
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:background="@drawable/widget_gradient" />

    <!-- App label -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✦ HOVR"
            android:textColor="#E8FF00"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Launch overlay button -->
        <ImageView
            android:id="@+id/widgetBtnPlay"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_media_play"
            android:tint="#E8FF00"
            android:contentDescription="Lanzar overlay" />

    </LinearLayout>

    <!-- Empty state (shown when no favorites) -->
    <LinearLayout
        android:id="@+id/widgetEmptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✦"
            android:textColor="#E8FF00"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sin favoritos"
            android:textColor="#555555"
            android:fontFamily="monospace"
            android:textSize="10sp"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</FrameLayout>
