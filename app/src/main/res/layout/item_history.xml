<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="3dp"
    android:background="@drawable/card_bg"
    android:clickable="true"
    android:focusable="true">

    <!-- Thumbnail -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="12dp">

        <ImageView
            android:id="@+id/ivThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="#1E1A14"
            android:contentDescription="Miniatura" />

        <!-- GIF badge -->
        <TextView
            android:id="@+id/tvGifBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:text="GIF"
            android:textColor="#F0A050"
            android:fontFamily="monospace"
            android:textSize="7sp"
            android:background="#B01A1612"
            android:paddingHorizontal="3dp"
            android:paddingVertical="1dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Name + time -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#C8BEB0"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#4A3A2A"
            android:fontFamily="monospace"
            android:textSize="10sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Delete -->
    <TextView
        android:id="@+id/btnDelete"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:text="✕"
        android:textColor="#3A2828"
        android:textSize="12sp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
